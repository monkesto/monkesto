{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT f.id as \"id: FundId\", f.journal_id as \"journal_id: JournalId\", f.name as \"name: Name\", f.balance, e.payload as \"payload!\"\n            FROM funds f\n            INNER JOIN event e\n                ON e.account_id = f.id AND e.event_type = 'FundCreated'\n            WHERE e.journal_id = $1\n            ",
