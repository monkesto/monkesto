{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT f.id as \"id: FileId\", f.journal_id as \"journal_id: JournalId\", f.hash as \"hash: [u8; 16]\", f.name, e.payload as \"payload!: JournalDomainEvent\"\n            FROM files f\n            INNER JOIN event e\n                ON e.file_id = f.id AND e.event_type = 'FileUploaded'\n            WHERE f.journal_id = $1\n            ",
