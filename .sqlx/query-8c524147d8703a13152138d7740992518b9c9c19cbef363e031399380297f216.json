{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT j.id as \"id: JournalId\", j.owner_id as \"owner_id: UserId\", j.name as \"name: Name\", e.payload as \"payload!: JournalDomainEvent\"\n            FROM journals j\n            INNER JOIN event e\n                ON e.journal_id = $1 AND e.event_type = 'JournalCreated'\n            WHERE j.id = $1\n            ",
